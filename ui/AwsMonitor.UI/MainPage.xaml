<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:vm="clr-namespace:AwsMonitor.UI.ViewModels"
             xmlns:models="clr-namespace:AwsMonitor.UI.Models"
             x:Class="AwsMonitor.UI.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#0B0F19">

    <Grid RowDefinitions="Auto,Auto,*" Margin="{OnIdiom Phone='10,8', Default='16,12'}" RowSpacing="10">

        <Border Grid.Row="0"
                BackgroundColor="#131B2E"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="{OnIdiom Phone='14,10', Default='18,12'}"
                StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="3">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="AWS Monitor"
                                   FontSize="{OnIdiom Phone=17, Default=19}"
                                   FontAttributes="Bold"
                                   TextColor="#38BDF8"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="#0F3554"
                                    Stroke="#0284C7"
                                    StrokeThickness="1"
                                    Padding="8,2"
                                    StrokeShape="RoundRectangle 4"
                                    VerticalOptions="Center">
                                <Label Text="Station QC"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="#38BDF8" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding LocationText}"
                               FontSize="11"
                               TextColor="#94A3B8"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Border BackgroundColor="#0F172A"
                                Stroke="{Binding ConnectionStatusColor}"
                                StrokeThickness="1"
                                Padding="10,4"
                                StrokeShape="RoundRectangle 6"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="Real-time backend API connectivity status.">
                            <Label Text="{Binding ConnectionStatusText}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{Binding ConnectionStatusColor}" />
                        </Border>
                        <Button Text="Server"
                                Command="{Binding ToggleServerSettingsCommand}"
                                BackgroundColor="#1E293B"
                                TextColor="#94A3B8"
                                FontSize="10"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="30"
                                Padding="10,0"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="Configure backend API server URL (e.g. localhost or remote host)." />
                        <Button Text="Refresh"
                                Command="{Binding RefreshAllCommand}"
                                BackgroundColor="#1E293B"
                                TextColor="#38BDF8"
                                FontSize="10"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="30"
                                Padding="10,0"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="Fetch latest telemetry, sensor health, and anomaly incident logs from the backend." />
                    </HorizontalStackLayout>
                </Grid>

                <Border IsVisible="{Binding IsServerSettingsVisible}"
                        BackgroundColor="#0F172A"
                        Stroke="#334155"
                        StrokeThickness="1"
                        Padding="10,8"
                        StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="API Server:" FontSize="11" TextColor="#94A3B8" VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                                Text="{Binding ServerUrlInput}"
                                TextColor="#F8FAFC"
                                Placeholder="http://127.0.0.1:8000"
                                PlaceholderColor="#64748B"
                                FontSize="11"
                                HeightRequest="32"
                                VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="Localhost"
                                Command="{Binding UseLocalhostCommand}"
                                BackgroundColor="#1E293B"
                                TextColor="#38BDF8"
                                FontSize="10"
                                HeightRequest="30"
                                Padding="8,0"
                                CornerRadius="4"
                                ToolTipProperties.Text="Set backend URL to default local address: http://127.0.0.1:8000." />
                        <Button Grid.Column="3"
                                Text="Connect"
                                Command="{Binding SaveServerUrlCommand}"
                                BackgroundColor="#0284C7"
                                TextColor="#FFFFFF"
                                FontSize="10"
                                FontAttributes="Bold"
                                HeightRequest="30"
                                Padding="12,0"
                                CornerRadius="4"
                                ToolTipProperties.Text="Connect to specified API server and test health endpoint." />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="#131B2E"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="5"
                StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                  ColumnSpacing="6"
                  RowSpacing="6">

                <Button Grid.Row="0" Grid.Column="0"
                        Text="Overview"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Overview"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding OverviewTabBg}"
                        TextColor="White"
                        ToolTipProperties.Text="Overview: Station telemetry summary, key operational metrics, and historical time series charts." />

                <Button Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=1}"
                        Text="Incidents &amp; Health"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Incidents"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding IncidentsTabBg}"
                        TextColor="White"
                        ToolTipProperties.Text="Incidents &amp; Health: Tower sensor health monitoring, failure category breakdown, and anomaly event logs." />

                <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}"
                        Text="Sensor Simulator"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Tester"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding TesterTabBg}"
                        TextColor="White"
                        ToolTipProperties.Text="Sensor Simulator: Interactive diagnostic tester with fault injection presets, SHAP explanations, and self-healing." />

                <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}"
                        Text="AI Models &amp; SHAP"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Models"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding ModelsTabBg}"
                        TextColor="White"
                        ToolTipProperties.Text="AI Models &amp; SHAP: Global TreeSHAP feature importance rankings, throughput benchmarks, and ground-truth fault evaluations." />
            </Grid>
        </Border>

        <Grid Grid.Row="2">

            <ScrollView IsVisible="{Binding IsOverviewTab}" InputTransparent="{Binding IsNotOverviewTab}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="10"
                          RowSpacing="10">

                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=0}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Total weather observation records collected by the ISRO AWS station (sampled every 30 minutes across 2021-2022).">
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="TOTAL OBSERVATIONS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Total weather observation records collected by the ISRO AWS station (sampled every 30 minutes across 2021-2022).">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding TotalReadingsCount, StringFormat='{0:N0} Records'}" FontSize="20" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="{Binding DateRangeText}" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Physical hardware sensor malfunctions identified (ADC voltage spikes, sensor freezes, and unphysical steps).">
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="SENSOR FAULTS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Physical hardware sensor malfunctions identified (ADC voltage spikes, sensor freezes, and unphysical steps).">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding ProbableFaultsCount, StringFormat='{0} Faults'}" FontSize="20" FontAttributes="Bold" TextColor="#EF4444" />
                                <Label Text="Hardware glitches detected" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Genuine natural atmospheric extremes (heatwaves, storms) confirmed benign by multi-sensor physical consistency.">
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="WEATHER EXTREMES" FontSize="10" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Genuine natural atmospheric extremes (heatwaves, storms) confirmed benign by multi-sensor physical consistency.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding WeatherExtremesCount, StringFormat='{0} Extremes'}" FontSize="20" FontAttributes="Bold" TextColor="#F59E0B" />
                                <Label Text="Natural extremes confirmed" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Overall AWS operational health percentage, calculated across sensor uptime, calibration fidelity, and fault frequency.">
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="STATION HEALTH" FontSize="10" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Overall AWS operational health percentage, calculated across sensor uptime, calibration fidelity, and fault frequency.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding HealthScore, StringFormat='{0:F1}%'}" FontSize="20" FontAttributes="Bold" TextColor="#10B981" />
                                    <Border BackgroundColor="#064E3B" Padding="4,1" StrokeShape="RoundRectangle 4" VerticalOptions="Center"
                                            ToolTipProperties.Text="Station health grade based on physical consistency thresholds.">
                                        <Label Text="EXCELLENT" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="Surface channels operational" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10"
                            ToolTipProperties.Text="Summary of ISRO AWS automated quality control engine and multi-sensor validation algorithms.">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Text="Station Quality Control" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                        ToolTipProperties.Text="Automated telemetry monitoring for Automatic Weather Stations. Uses 13 physical meteorological indicators (dew point depression, solar diurnal variations, and rate-of-change limits) to distinguish hardware faults from natural extreme weather.">
                                    <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <Label Text="Automated telemetry monitoring for Automatic Weather Stations. Uses 13 physical meteorological indicators (dew point depression, solar diurnal variations, and rate-of-change limits) to distinguish hardware faults from natural extreme weather."
                                   FontSize="11" TextColor="#CBD5E1" LineBreakMode="WordWrap" />

                            <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                                <Button Text="Incidents &amp; Health"
                                        Command="{Binding SwitchTabCommand}"
                                        CommandParameter="Incidents"
                                        BackgroundColor="#0284C7" TextColor="White"
                                        FontSize="{OnIdiom Phone=13, Default=11}"
                                        HeightRequest="{OnIdiom Phone=42, Default=34}"
                                        CornerRadius="6" Padding="16,0"
                                        ToolTipProperties.Text="Navigate to Tower Sensor Health and Incidents Log tab." />

                                <Button Text="Test Diagnostics"
                                        Command="{Binding SwitchTabCommand}"
                                        CommandParameter="Tester"
                                        BackgroundColor="#1E293B" TextColor="#38BDF8" BorderColor="#38BDF8" BorderWidth="1"
                                        FontSize="{OnIdiom Phone=13, Default=11}"
                                        HeightRequest="{OnIdiom Phone=42, Default=34}"
                                        CornerRadius="6" Padding="16,0"
                                        ToolTipProperties.Text="Navigate to interactive Sensor Simulator tab." />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Real Historical Telemetry Timeseries & Anomaly Chart -->
                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10"
                            ToolTipProperties.Text="Historical timeseries showing sensor telemetry alongside model-flagged anomaly detections.">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding ChartTitle}" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="{Binding ChartSubtitle}" FontSize="10" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Historical timeseries graph showing sensor telemetry (blue line) alongside model-flagged anomaly detections (red markers).">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="Temperature"
                                            Command="{Binding SelectChannelCommand}"
                                            CommandParameter="Temperature"
                                            BackgroundColor="{Binding TempBtnBg}"
                                            TextColor="White"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            HeightRequest="28"
                                            Padding="10,0"
                                            CornerRadius="4"
                                            ToolTipProperties.Text="Plot 2m air temperature observations (°C) with diurnal range thresholds." />
                                    <Button Text="Humidity"
                                            Command="{Binding SelectChannelCommand}"
                                            CommandParameter="Humidity"
                                            BackgroundColor="{Binding HumidityBtnBg}"
                                            TextColor="White"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            HeightRequest="28"
                                            Padding="10,0"
                                            CornerRadius="4"
                                            ToolTipProperties.Text="Plot relative humidity telemetry (%) and dew-point depression physical bounds." />
                                    <Button Text="Pressure"
                                            Command="{Binding SelectChannelCommand}"
                                            CommandParameter="Pressure"
                                            BackgroundColor="{Binding PressureBtnBg}"
                                            TextColor="White"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            HeightRequest="28"
                                            Padding="10,0"
                                            CornerRadius="4"
                                            ToolTipProperties.Text="Plot barometric surface pressure (hPa) and rapid rate-of-change step flags." />
                                </HorizontalStackLayout>
                            </Grid>

                            <lvc:CartesianChart Series="{Binding ChartSeries}"
                                                XAxes="{Binding ChartXAxes}"
                                                YAxes="{Binding ChartYAxes}"
                                                MinimumHeightRequest="260"
                                                TooltipPosition="Top"
                                                ToolTipProperties.Text="Interactive timeseries chart: Hover over points to see exact timestamp and value." />

                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                                <Label Grid.Column="0" Text="{Binding TelemetryLegend1Title}" FontSize="10" TextColor="{Binding TelemetryLegend1Color}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding TelemetryLegend1Value}" FontSize="10" TextColor="#F8FAFC" />
                                <Label Grid.Column="2" Text="{Binding TelemetryLegend2Title}" FontSize="10" TextColor="{Binding TelemetryLegend2Color}" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="{Binding TelemetryLegend2Value}" FontSize="10" TextColor="#F8FAFC" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding IsIncidentsTab}" InputTransparent="{Binding IsNotIncidentsTab}">
                <VerticalStackLayout Spacing="14">

                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                            ToolTipProperties.Text="Real-time operational status and calibration fidelity for individual tower-mounted meteorological instruments.">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tower Sensor Health &amp; Physical Calibration" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                    <Label Text="Live operational integrity across atmospheric sensing instruments:" FontSize="10" TextColor="#94A3B8" />
                                </VerticalStackLayout>
                                <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                        ToolTipProperties.Text="Health scores are computed from step continuity, flatline persistence, and physical bounds checks across 32,774 observations.">
                                    <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#064E3B" Stroke="Transparent" Padding="8,3" StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                    ToolTipProperties.Text="Composite operational status of all sensor channels on the AWS tower.">
                                <Label Text="{Binding OverallStatusText}" FontSize="10" FontAttributes="Bold" TextColor="#34D399" />
                            </Border>
                        </Grid>
                    </Border>

                    <FlexLayout Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding SensorsList}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SensorChannelHealth">
                                <Border WidthRequest="{OnIdiom Phone=340, Default=340}"
                                        Margin="0,0,8,8"
                                        BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                        ToolTipProperties.Text="Sensor diagnostic card: Evaluates hardware fidelity, step continuity, and physical range constraints.">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}" FontSize="12" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Evaluates hardware fidelity, flatline persistence, and rate-of-change limits for this sensor.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="2" BackgroundColor="#064E3B" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Operating grade based on WMO QC compliance.">
                                                <Label Text="{Binding Status}" FontSize="9" FontAttributes="Bold" TextColor="{Binding StatusBadgeColor}" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Border BackgroundColor="#0B1220" Stroke="#1E293B" Padding="8,6" StrokeShape="RoundRectangle 6"
                                                    ToolTipProperties.Text="Channel quality percentage calculated from anomaly frequency and flatline duration.">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="HEALTH SCORE" FontSize="8" TextColor="#64748B" FontAttributes="Bold" />
                                                    <Label Text="{Binding QualityScorePct, StringFormat='{0:F1}%'}" FontSize="13" FontAttributes="Bold" TextColor="#34D399" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Grid.Column="1" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="8,6" StrokeShape="RoundRectangle 6"
                                                    ToolTipProperties.Text="Total count of anomalous readings detected on this specific sensor channel across all observations.">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="FLAGGED EVENTS" FontSize="8" TextColor="#64748B" FontAttributes="Bold" />
                                                    <Label Text="{Binding FlaggedAnomalyCount, StringFormat='{0:N0}'}" FontSize="13" FontAttributes="Bold" TextColor="#F59E0B" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding QualityDescription}" FontSize="9" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.05*,0.95*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">

                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Categorical distribution of all sensor anomalies: Spikes, frozen sensors, ground faults, and benign extremes.">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Anomalies by Failure Category" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="Model classification of identified sensor anomalies across 32,774 records:" FontSize="10" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Horizontal bar chart categorizing identified sensor anomalies into physical root causes: Spikes, transient steps, benign extremes, ground faults, freezes, and humidity collapses.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <lvc:CartesianChart Series="{Binding IncidentChartSeries}"
                                                    XAxes="{Binding IncidentXAxes}"
                                                    YAxes="{Binding IncidentYAxes}"
                                                    MinimumHeightRequest="220"
                                                    TooltipPosition="Top"
                                                    ToolTipProperties.Text="Chart displaying event counts per failure category." />

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="10,8" StrokeShape="RoundRectangle 6">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <VerticalStackLayout Spacing="1" ToolTipProperties.Text="Total number of anomalous events classified by the ML and physics engine.">
                                            <Label Text="TOTAL ANALYZED" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                            <Label Text="{Binding ProblemIncidentsCount, StringFormat='{0:N0}'}" FontSize="11" FontAttributes="Bold" TextColor="#F8FAFC" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" ToolTipProperties.Text="Hardware instrument malfunctions requiring maintenance or recalibration.">
