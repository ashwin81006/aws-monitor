<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:vm="clr-namespace:AwsMonitor.UI.ViewModels"
             xmlns:models="clr-namespace:AwsMonitor.UI.Models"
             x:Class="AwsMonitor.UI.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#0B0F19">

    <Grid RowDefinitions="Auto,Auto,*" Margin="{OnIdiom Phone='10,8', Default='16,12'}" RowSpacing="10">

        <!-- ========================================================= -->
        <!-- ROW 0: CLEAN WEATHER-TRUST STYLE HEADER                   -->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                BackgroundColor="#131B2E"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="{OnIdiom Phone='14,10', Default='18,12'}"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="3">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="AWS MONITOR"
                           FontSize="{OnIdiom Phone=18, Default=20}"
                           FontAttributes="Bold"
                           TextColor="#38BDF8"
                           VerticalOptions="Center" />
                    <Border BackgroundColor="#0F3554"
                            Stroke="#0284C7"
                            StrokeThickness="1"
                            Padding="8,2"
                            StrokeShape="RoundRectangle 6"
                            VerticalOptions="Center">
                        <Label Text="Weather Station Quality Control"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#38BDF8" />
                    </Border>
                </HorizontalStackLayout>
                <Label Text="{Binding LocationText}"
                       FontSize="11"
                       TextColor="#94A3B8"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 1: CLEAN TOP NAVIGATION PILLS (WeatherTrust Style)   -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                BackgroundColor="#131B2E"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="6"
                StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                  ColumnSpacing="8"
                  RowSpacing="6">

                <Button Grid.Row="0" Grid.Column="0"
                        Text="🏠 Overview"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Overview"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="6,0"
                        BackgroundColor="{Binding OverviewTabBg}"
                        TextColor="White" />

                <Button Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=1}"
                        Text="📈 Telemetry"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Telemetry"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="6,0"
                        BackgroundColor="{Binding TelemetryTabBg}"
                        TextColor="White" />

                <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}"
                        Text="⚡ Fault Tester &amp; Self-Healing"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Tester"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="6,0"
                        BackgroundColor="{Binding TesterTabBg}"
                        TextColor="White" />

                <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}"
                        Text="📊 AI Models"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Models"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="6,0"
                        BackgroundColor="{Binding ModelsTabBg}"
                        TextColor="White" />
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ROW 2: DYNAMIC TAB VIEW BODY (Clean Boolean Visibility)   -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2">

            <!-- ===================================================== -->
            <!-- TAB: OVERVIEW (Key Summary Cards + Quick Insights)    -->
            <!-- ===================================================== -->
            <ScrollView IsVisible="{Binding IsOverviewTab}" InputTransparent="{Binding IsNotOverviewTab}">
                <VerticalStackLayout Spacing="14">
                    <!-- 4 WeatherTrust Summary KPI Cards -->
                    <Grid ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="10"
                          RowSpacing="10">

                        <!-- Card 1: Total Observations -->
                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=0}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="TOTAL OBSERVATIONS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding TotalReadingsCount, StringFormat='{0:N0} Records'}" FontSize="20" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="{Binding DateRangeText}" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 2: Probable Sensor Faults -->
                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="PROBABLE SENSOR FAULTS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding ProbableFaultsCount, StringFormat='{0} Faults'}" FontSize="20" FontAttributes="Bold" TextColor="#EF4444" />
                                <Label Text="Hardware glitches, spikes &amp; freezes" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 3: Possible Extremes -->
                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="POSSIBLE EXTREMES" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding WeatherExtremesCount, StringFormat='{0} Extremes'}" FontSize="20" FontAttributes="Bold" TextColor="#F59E0B" />
                                <Label Text="Real heatwaves &amp; storms verified" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 4: Station Reliability -->
                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="STATION RELIABILITY" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding HealthScore, StringFormat='{0:F1}%'}" FontSize="20" FontAttributes="Bold" TextColor="#10B981" />
                                    <Border BackgroundColor="#064E3B" Padding="4,1" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                        <Label Text="EXCELLENT" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="All 3 surface channels continuously monitored" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Station Overview & Project Mission Card -->
                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="About This Monitoring System" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                            <Label Text="Automatic Weather Stations (AWS) continuously record temperature, relative humidity, and atmospheric pressure. Hardware glitches, communication failures, frozen sensors, and power losses can corrupt this critical weather data."
                                   FontSize="11" TextColor="#CBD5E1" LineBreakMode="WordWrap" />
                            <Label Text="Traditional fixed threshold checks fail because they miss subtle sensor drift and falsely flag genuine extreme weather like heatwaves. This project uses 13 physical meteorological features (thermodynamic dew point depression, diurnal solar deviations, and rates of change) to detect true hardware glitches while rejecting benign natural extremes with 100% precision."
                                   FontSize="11" TextColor="#94A3B8" LineBreakMode="WordWrap" />

                            <BoxView HeightRequest="1" Color="#1E293B" Margin="0,4" />

                            <!-- Quick Action Buttons -->
                            <Label Text="Quick Actions to Explore:" FontSize="11" FontAttributes="Bold" TextColor="#CBD5E1" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="📈 View Live Telemetry Graph"
                                        Command="{Binding SwitchTabCommand}"
                                        CommandParameter="Telemetry"
                                        BackgroundColor="#0284C7" TextColor="White" FontSize="11" FontAttributes="Bold" HeightRequest="36" CornerRadius="6" />

                                <Button Text="⚡ Test a Broken Sensor Demo"
                                        Command="{Binding SwitchTabCommand}"
                                        CommandParameter="Tester"
                                        BackgroundColor="#10B981" TextColor="White" FontSize="11" FontAttributes="Bold" HeightRequest="36" CornerRadius="6" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ===================================================== -->
            <!-- TAB: TELEMETRY EXPLORER (The Interactive Graph!)      -->
            <!-- ===================================================== -->
            <Grid IsVisible="{Binding IsTelemetryTab}" InputTransparent="{Binding IsNotTelemetryTab}" RowDefinitions="Auto,*,Auto" RowSpacing="10">

                <!-- Channel Toggles & Preset Jump Buttons -->
                <Border Grid.Row="0"
                        BackgroundColor="#131B2E"
                        Stroke="#1E293B"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='Auto,*'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='*'}" RowSpacing="8">
                        <!-- Sensor Channel Buttons -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="Sensor:" FontSize="11" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" Margin="0,0,4,0" />

                            <Button Text="🌡️ Temp"
                                     Command="{Binding SelectChannelCommand}"
                                     CommandParameter="Temperature"
                                     BackgroundColor="{Binding TempBtnBg}"
                                     TextColor="White"
                                     FontSize="10" FontAttributes="Bold" HeightRequest="32" CornerRadius="6" Padding="10,0" />

                            <Button Text="💧 Humidity"
                                     Command="{Binding SelectChannelCommand}"
                                     CommandParameter="Humidity"
                                     BackgroundColor="{Binding HumidityBtnBg}"
                                     TextColor="White"
                                     FontSize="10" FontAttributes="Bold" HeightRequest="32" CornerRadius="6" Padding="10,0" />

                            <Button Text="⏱️ Pressure"
                                     Command="{Binding SelectChannelCommand}"
                                     CommandParameter="Pressure"
                                     BackgroundColor="{Binding PressureBtnBg}"
                                     TextColor="White"
                                     FontSize="10" FontAttributes="Bold" HeightRequest="32" CornerRadius="6" Padding="10,0" />

                        </HorizontalStackLayout>

                        <!-- Historical Event Quick-Jumps -->
                        <HorizontalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}"
                                               Grid.Column="{OnIdiom Phone=0, Default=1}"
                                               Spacing="6"
                                               HorizontalOptions="{OnIdiom Phone=Start, Default=End}"
                                               VerticalOptions="Center">
                            <Label Text="Jump to Event:" FontSize="10" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />

                            <Button Text="📊 Normal History"
                                    Command="{Binding ResetToHistoricalStreamCommand}"
                                    BackgroundColor="#1E293B" TextColor="#38BDF8" FontSize="10" HeightRequest="30" CornerRadius="6" Padding="8,0" />

                            <Button Text="⚡ Spike (-33°C)"
                                    Command="{Binding ZoomToSpikeFaultCommand}"
                                    BackgroundColor="#2E1065" TextColor="#C084FC" FontSize="10" HeightRequest="30" CornerRadius="6" Padding="8,0" />

                            <Button Text="❄️ Freeze (Flatline)"
                                    Command="{Binding ZoomToFreezeFaultCommand}"
                                    BackgroundColor="#0C4A6E" TextColor="#38BDF8" FontSize="10" HeightRequest="30" CornerRadius="6" Padding="8,0" />

                            <Button Text="🔥 Heatwave (46°C)"
                                    Command="{Binding ZoomToHeatwaveCommand}"
                                    BackgroundColor="#451A03" TextColor="#FBBF24" FontSize="10" HeightRequest="30" CornerRadius="6" Padding="8,0" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- THE CHART CONTAINER (Guaranteed Positive Height) -->
                <Border Grid.Row="1"
                        BackgroundColor="#131B2E"
                        Stroke="#1E293B"
                        Padding="14"
                        StrokeShape="RoundRectangle 12">
                    <Grid RowDefinitions="Auto,*">
                        <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                            <Label Text="{Binding ChartTitle}" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                            <Label Text="{Binding ChartSubtitle}" FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>

                        <!-- LiveCharts2 Cartesian Chart Control -->
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding ChartSeries}"
                                            XAxes="{Binding ChartXAxes}"
                                            YAxes="{Binding ChartYAxes}"
                                            MinimumHeightRequest="240"
                                            TooltipPosition="Top" />
                    </Grid>
                </Border>

                <!-- Bottom Telemetry Legend & Stat Pills -->
                <Border Grid.Row="2"
                        BackgroundColor="#131B2E"
                        Stroke="#1E293B"
                        Padding="12,8"
                        StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="{Binding TelemetryLegend1Title}" FontSize="9" TextColor="#64748B" />
                            <Label Text="{Binding TelemetryLegend1Value}" FontSize="11" FontAttributes="Bold" TextColor="{Binding TelemetryLegend1Color}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="{Binding TelemetryLegend2Title}" FontSize="9" TextColor="#64748B" />
                            <Label Text="{Binding TelemetryLegend2Value}" FontSize="11" FontAttributes="Bold" TextColor="{Binding TelemetryLegend2Color}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                            <Label Text="{Binding TelemetryLegend3Title}" FontSize="9" TextColor="#64748B" />
                            <Label Text="{Binding TelemetryLegend3Value}" FontSize="11" FontAttributes="Bold" TextColor="{Binding TelemetryLegend3Color}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="1">
                            <Label Text="{Binding TelemetryLegend4Title}" FontSize="9" TextColor="#64748B" />
                            <Label Text="{Binding TelemetryLegend4Value}" FontSize="11" FontAttributes="Bold" TextColor="{Binding TelemetryLegend4Color}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- TAB: TEST A SENSOR / FAULT SIMULATOR                  -->
                   <!-- ===================================================== -->
            <!-- TAB: TEST A SENSOR & THERMODYNAMIC SELF-HEALING       -->
            <!-- ===================================================== -->
            <ScrollView IsVisible="{Binding IsTesterTab}" InputTransparent="{Binding IsNotTesterTab}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.1*,0.9*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">

                        <!-- Left: Test Inputs & Presets -->
                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=0}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Test Sensor Readings &amp; Inject Faults" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="Simulate realistic sensor hardware malfunctions vs genuine severe weather events to test thermodynamic self-healing:" FontSize="11" TextColor="#94A3B8" />

                                <!-- Scenarios -->
                                <Label Text="1-Click Demonstration Scenarios:" FontSize="11" FontAttributes="Bold" TextColor="#CBD5E1" />
                                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                    <Button Text="☀️ Normal Tropical Day" Command="{Binding LoadPresetNormalCommand}"
                                            BackgroundColor="#1E293B" TextColor="#34D399" FontSize="10" HeightRequest="32" CornerRadius="6" Margin="0,0,6,6" Padding="10,0" />
                                    <Button Text="⚡ Glitched Spike (-33°C)" Command="{Binding LoadPresetSpikeCommand}"
                                            BackgroundColor="#1E293B" TextColor="#F87171" FontSize="10" HeightRequest="32" CornerRadius="6" Margin="0,0,6,6" Padding="10,0" />
                                    <Button Text="❄️ Stuck / Flatline Sensor" Command="{Binding LoadPresetFreezeCommand}"
                                            BackgroundColor="#1E293B" TextColor="#60A5FA" FontSize="10" HeightRequest="32" CornerRadius="6" Margin="0,0,6,6" Padding="10,0" />
                                    <Button Text="🔥 Tropical Heatwave (46.5°C)" Command="{Binding LoadPresetHeatwaveCommand}"
                                            BackgroundColor="#1E293B" TextColor="#FBBF24" FontSize="10" HeightRequest="32" CornerRadius="6" Margin="0,0,6,6" Padding="10,0" />
                                    <Button Text="🌀 Monsoon Storm (Low P)" Command="{Binding LoadPresetStormCommand}"
                                            BackgroundColor="#1E293B" TextColor="#A78BFA" FontSize="10" HeightRequest="32" CornerRadius="6" Margin="0,0,6,6" Padding="10,0" />
                                </FlexLayout>

                                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,2" />

                                <!-- Values Input -->
                                <Label Text="Station Telemetry Inputs (3 Physical Channels):" FontSize="11" FontAttributes="Bold" TextColor="#CBD5E1" />
                                <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,*,*'}" ColumnSpacing="8" RowSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Air Temperature (°C)" FontSize="10" TextColor="#94A3B8" />
                                        <Entry Text="{Binding TestTemperature}" Keyboard="Numeric" BackgroundColor="#0F172A" TextColor="#E2E8F0" HeightRequest="36" FontSize="11" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.Row="{OnIdiom Phone=1, Default=0}" Spacing="3">
                                        <Label Text="Relative Humidity (%)" FontSize="10" TextColor="#94A3B8" />
                                        <Entry Text="{Binding TestHumidity}" Keyboard="Numeric" BackgroundColor="#0F172A" TextColor="#E2E8F0" HeightRequest="36" FontSize="11" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Default=2}" Grid.Row="{OnIdiom Phone=2, Default=0}" Spacing="3">
                                        <Label Text="Pressure (hPa)" FontSize="10" TextColor="#94A3B8" />
                                        <Entry Text="{Binding TestPressure}" Keyboard="Numeric" BackgroundColor="#0F172A" TextColor="#E2E8F0" HeightRequest="36" FontSize="11" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Text="🔍 Run Diagnosis &amp; Self-Healing"
                                        Command="{Binding RunTestInferenceCommand}"
                                        BackgroundColor="#0284C7"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HeightRequest="40"
                                        CornerRadius="6" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Right: Diagnosis & Thermodynamic Self-Healing Result -->
                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Diagnosis &amp; Thermodynamic Self-Healing" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />

                                <!-- Status Badge -->
                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="14,10" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="SYSTEM VERDICT" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                            <Border BackgroundColor="{Binding ResultBadgeColor}" Padding="10,4" StrokeShape="RoundRectangle 6">
                                                <Label Text="{Binding ResultStatusBadge}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                            <Label Text="{Binding ResultConfidenceText}" FontSize="12" TextColor="#CBD5E1" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Which Problem & Which Sensor -->
                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="FAULT CLASSIFICATION:" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding ResultFaultTypeSimple}" FontSize="13" FontAttributes="Bold" TextColor="#F59E0B" />
                                        <Label Text="AFFECTED SENSOR:" FontSize="10" FontAttributes="Bold" TextColor="#64748B" Margin="0,4,0,0" />
                                        <Label Text="{Binding ResultAffectedSensorsText}" FontSize="12" FontAttributes="Bold" TextColor="#F87171" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Plain English Meteorological Explanation -->
                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="METEOROLOGICAL REASONING:" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="{Binding ResultExplanationSimple}" FontSize="11" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Thermodynamic Self-Healing Card -->
                                <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="12" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="PHYSICS-BASED SELF-HEALING:" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding HealingBadgeColor}" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                <Label Text="{Binding HealingMethodText}" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding ReconstructionDetailsText}" FontSize="11" TextColor="#F1F5F9" LineBreakMode="WordWrap" />
                                        <Label Text="Physics Model: Magnus-Tetens Saturation Vapor Pressure &amp; Hydrostatic Lapse Rate for Vellore (214m elevation)."
                                               FontSize="9" TextColor="#94A3B8" FontAttributes="Italic" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ===================================================== -->
            <!-- TAB: AI MODEL BENCHMARK & TREE-SHAP EXPLAINABILITY     -->
            <!-- ===================================================== -->
            <ScrollView IsVisible="{Binding IsModelsTab}" InputTransparent="{Binding IsNotModelsTab}">
                <VerticalStackLayout Spacing="14">
                    <!-- Benchmark Header -->
                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="🏆" FontSize="16" VerticalOptions="Center" />
                                <Label Text="AI Model Evaluation &amp; TreeSHAP Explainability" FontSize="14" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Empirical benchmark across 32,774 ISRO AWS observations and global feature attributions across the 13 domain features:"
                                   FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Split Grid: Left = SHAP Feature Importance, Right = Models Benchmark -->
                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.05*,0.95*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">

                        <!-- Left Column: SHAP Feature Attribution -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="What Factors Matter Most? (TreeSHAP)" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                    <Label Text="Global Shapley feature attribution ranking for the 13 meteorological features:" FontSize="10" TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <!-- LiveCharts2 Horizontal Bar Chart -->
                                <lvc:CartesianChart Series="{Binding ShapChartSeries}"
                                                    XAxes="{Binding ShapXAxes}"
                                                    YAxes="{Binding ShapYAxes}"
                                                    MinimumHeightRequest="270"
                                                    TooltipPosition="Top" />

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,10" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="💡 KEY METEOROLOGICAL INSIGHT:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="{Binding ShapPrimaryInsight}"
                                               FontSize="10" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Right Column: Candidate Models Comparison -->
                        <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="10">
                            <!-- Models Cards List -->
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding BenchmarkList}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModelBenchmarkItem">
                                        <Border BackgroundColor="{Binding CardBackground}" Stroke="{Binding CardStroke}" Padding="14,12" StrokeShape="RoundRectangle 10">
                                            <VerticalStackLayout Spacing="6">
                                                <!-- Title & Status Badge -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                    <Label Text="{Binding ModelName}" FontSize="13" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
                                                    <Border Grid.Column="1" BackgroundColor="{Binding StatusBadgeBg}" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                        <Label Text="{Binding StatusBadgeLabel}" FontSize="9" FontAttributes="Bold" TextColor="{Binding StatusBadgeText}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Role description -->
                                                <Label Text="{Binding Role}" FontSize="10" TextColor="#94A3B8" />

                                                <!-- Key Metrics Strip -->
                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,2,0,0">
                                                    <Border BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="THROUGHPUT" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayThroughput, StringFormat='{0:N0}'}" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="1" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="MODEL SIZE" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayDiskSize, StringFormat='{0:F0} KB'}" FontSize="10" FontAttributes="Bold" TextColor="#A855F7" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="2" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="TRAIN TIME" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding FitTimeSeconds, StringFormat='{0:F2}s'}" FontSize="10" FontAttributes="Bold" TextColor="#10B981" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="3" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="OUTLIER" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding OutlierRatePct, StringFormat='{0:F1}%'}" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>

                                                <!-- Strengths & Takeaway -->
                                                <Label Text="{Binding Strengths}" FontSize="9" TextColor="#CBD5E1" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Production Decision Callout -->
                            <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="12" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="🎯 Production Selection Rationale" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" />
                                    <Label Text="Isolation Forest achieves 87,650 obs/sec inference throughput (3x faster than SVM, 5.5x faster than LOF) with sub-second fit time (0.19s) and native TreeSHAP explainability."
                                           FontSize="10" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>

</ContentPage>
