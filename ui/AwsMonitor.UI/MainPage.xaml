                                ToolTipProperties.Text="Chronological incident log of identified weather station anomalies with root-cause isolation. Click any incident to inspect.">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Flagged Anomaly Incidents Log" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="Detailed root cause isolation for logged station events:" FontSize="10" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Chronological log of weather station anomalies. Click any incident card to load its detailed root cause and physical rule flags.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border Grid.Column="2" BackgroundColor="#1E293B" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4" VerticalOptions="Center"
                                            ToolTipProperties.Text="Total number of logged anomaly incidents.">
                                        <Label Text="{Binding EventsList.Count, StringFormat='{0} Events'}" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding EventsList}">
