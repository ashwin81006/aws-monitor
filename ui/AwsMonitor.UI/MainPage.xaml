                                        <DataTemplate x:DataType="models:AnomalyEvent">
                                            <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,10" StrokeShape="RoundRectangle 8"
                                                    ToolTipProperties.Text="Click to inspect this incident's root cause, affected sensors, duration, and physical rule flags.">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=SelectEventCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label Text="{Binding RootCause}" FontSize="11" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
                                                        <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                            <Label Text="{Binding PeakScoreText}" FontSize="8" FontAttributes="Bold" TextColor="{Binding SeverityColor}" />
                                                        </Border>
                                                    </Grid>

                                                    <Label Text="{Binding Description}" FontSize="10" TextColor="#94A3B8" LineBreakMode="WordWrap" />

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2,0,0">
                                                        <Label Text="{Binding StartTime}" FontSize="9" TextColor="#64748B" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding EventClassification}" FontSize="9" FontAttributes="Bold" TextColor="{Binding SeverityColor}" HorizontalOptions="End" VerticalOptions="Center" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="14,12" StrokeShape="RoundRectangle 8" Margin="0,8,0,0"
                                        ToolTipProperties.Text="Comprehensive root-cause breakdown of the selected anomaly event, including physical rule triggers and sensor impacts.">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="SELECTED INCIDENT DEEP DIVE" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Detailed diagnostic telemetry and meteorological reasoning for the selected event.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="2" BackgroundColor="#0284C7" Padding="6,2" StrokeShape="RoundRectangle 4"
                                                    ToolTipProperties.Text="Duration of the anomalous event sequence.">
                                                <Label Text="{Binding SelectedEventDurationText, StringFormat='Duration: {0}'}" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding SelectedEventDetailExplanation}" FontSize="11" TextColor="#F1F5F9" LineBreakMode="WordWrap" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2,0,0">
                                            <Label Text="Rule Flags:" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" />
                                            <Label Grid.Column="1" Text="{Binding SelectedEventRuleFlags}" FontSize="9" TextColor="#FBBF24" LineBreakMode="WordWrap" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Label Text="Affected Sensors:" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" />
                                            <Label Grid.Column="1" Text="{Binding SelectedEventAffectedSensors}" FontSize="9" TextColor="#34D399" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding IsTesterTab}" InputTransparent="{Binding IsNotTesterTab}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.1*,0.9*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">
                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=0}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Interactive diagnostic sandbox: Choose a preset failure scenario or enter custom telemetry values to test ML inference.">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Fault Simulation" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="Select a scenario or enter telemetry values to test diagnostic classification and reconstruction:" FontSize="11" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Simulate sensor readings to test the multi-tier diagnostic system: physical rules, ML ensemble, SHAP attributions, and self-healing.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <Label Text="Preset Scenarios:" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#64748B" />
                                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                    <Button Text="Normal" Command="{Binding LoadPresetNormalCommand}"
                                            BackgroundColor="#1E293B" TextColor="#34D399" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0"
                                            ToolTipProperties.Text="Preset: Standard daytime tropical weather readings (28.5°C, 65% RH, 1008.2 hPa)." />
                                    <Button Text="Spike (-33°C)" Command="{Binding LoadPresetSpikeCommand}"
                                            BackgroundColor="#1E293B" TextColor="#F87171" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0"
                                            ToolTipProperties.Text="Preset: Severe ADC voltage glitch producing unphysical negative temperatures (-33°C)." />
                                    <Button Text="Sensor Freeze" Command="{Binding LoadPresetFreezeCommand}"
                                            BackgroundColor="#1E293B" TextColor="#60A5FA" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0"
                                            ToolTipProperties.Text="Preset: Frozen sensor maintaining zero variance across successive observation timesteps." />
                                    <Button Text="Heatwave (46°C)" Command="{Binding LoadPresetHeatwaveCommand}"
                                            BackgroundColor="#1E293B" TextColor="#FBBF24" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0"
                                            ToolTipProperties.Text="Preset: Natural high-temperature weather extreme confirmed benign by solar radiation and low RH." />
                                    <Button Text="Low Pressure" Command="{Binding LoadPresetStormCommand}"
                                            BackgroundColor="#1E293B" TextColor="#A78BFA" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0"
                                            ToolTipProperties.Text="Preset: Barometric transient drop (975.0 hPa) typical of severe tropical depression or monsoon storm." />
                                </FlexLayout>

                                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,4" />

                                <Label Text="Telemetry Inputs:" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#64748B" />
                                <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,*,*'}"
                                      RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Default='Auto'}"
                                      ColumnSpacing="10" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4"
                                                         ToolTipProperties.Text="Simulated ambient air temperature in Celsius (normal range: 10°C to 45°C).">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="Temperature (°C)" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Simulated ambient air temperature in Celsius (normal range: 10°C to 45°C).">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Border BackgroundColor="#0B1324"
                                                Stroke="#334155"
                                                StrokeThickness="1.5"
                                                Padding="12,0"
                                                StrokeShape="RoundRectangle 8"
                                                HeightRequest="{OnIdiom Phone=46, Default=36}">
                                            <Entry Text="{Binding TestTemperature}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#F8FAFC"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom Phone=15, Default=12}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="4"
                                                         ToolTipProperties.Text="Simulated relative humidity percentage (physical range: 5% to 100%).">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="Relative Humidity (%)" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#34D399" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Simulated relative humidity percentage (physical range: 5% to 100%).">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#34D399" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Border BackgroundColor="#0B1324"
                                                Stroke="#334155"
                                                StrokeThickness="1.5"
                                                Padding="12,0"
                                                StrokeShape="RoundRectangle 8"
                                                HeightRequest="{OnIdiom Phone=46, Default=36}">
                                            <Entry Text="{Binding TestHumidity}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#F8FAFC"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom Phone=15, Default=12}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=2, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}" Spacing="4"
                                                         ToolTipProperties.Text="Simulated station barometric pressure in hectopascals / hPa (normal: 990 to 1025 hPa).">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="Pressure (hPa)" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#A78BFA" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Simulated station barometric pressure in hectopascals / hPa (normal: 990 to 1025 hPa).">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#A78BFA" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Border BackgroundColor="#0B1324"
                                                Stroke="#334155"
                                                StrokeThickness="1.5"
                                                Padding="12,0"
                                                StrokeShape="RoundRectangle 8"
                                                HeightRequest="{OnIdiom Phone=46, Default=36}">
                                            <Entry Text="{Binding TestPressure}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#F8FAFC"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom Phone=15, Default=12}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Text="Run Diagnostics"
                                        Command="{Binding RunTestInferenceCommand}"
                                        BackgroundColor="#0284C7"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=14, Default=11}"
                                        HeightRequest="{OnIdiom Phone=46, Default=36}"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        ToolTipProperties.Text="Submit values to the calibrated ensemble to classify fault status, isolate affected channels, compute SHAP, and reconstruct values." />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Real-time inference output from the ML ensemble, physics rules engine, and self-healing reconstructor.">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="Diagnostic Results" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Detailed diagnostic results including overall verdict, fault classification, meteorological justification, self-healing reconstruction, and local SHAP impact.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,8" StrokeShape="RoundRectangle 6"
                                        ToolTipProperties.Text="Overall diagnostic verdict: Normal, Sensor Fault, or Benign Weather Extreme with confidence score.">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="VERDICT" FontSize="9" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Model prediction verdict indicating whether input observation is healthy, anomalous, or extreme weather.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Border BackgroundColor="{Binding ResultBadgeColor}" Padding="8,3" StrokeShape="RoundRectangle 4">
                                                <Label Text="{Binding ResultStatusBadge}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                            <Label Text="{Binding ResultConfidenceText}" FontSize="11" TextColor="#CBD5E1" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,8" StrokeShape="RoundRectangle 6"
                                        ToolTipProperties.Text="Specific failure category and the isolated sensor channel experiencing the defect.">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="CLASSIFICATION:" FontSize="9" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Categorizes the defect type (e.g. SENSOR_SPIKE, FROZEN_SENSOR) and pinpoints which sensor channel is faulty.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding ResultFaultTypeSimple}" FontSize="12" FontAttributes="Bold" TextColor="#F59E0B" />
                                        <Label Text="AFFECTED SENSOR:" FontSize="9" FontAttributes="Bold" TextColor="#64748B" Margin="0,3,0,0" />
                                        <Label Text="{Binding ResultAffectedSensorsText}" FontSize="11" FontAttributes="Bold" TextColor="#F87171" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,8" StrokeShape="RoundRectangle 6"
                                        ToolTipProperties.Text="Physical meteorological justification based on atmospheric thermodynamics and diurnal consistency.">
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="ANALYSIS:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Explains physical checks triggered: dew point depression, solar radiation, rate of change, and statistical deviation.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding ResultExplanationSimple}" FontSize="11" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="12,8" StrokeShape="RoundRectangle 6"
                                        ToolTipProperties.Text="Self-healing estimate computed via multi-channel spline interpolation and physical thermodynamics.">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="RECONSTRUCTED VALUE:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Self-healing virtual sensor reconstruction: Replaces corrupted or missing data with physically valid estimates.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Border Grid.Column="2" BackgroundColor="{Binding HealingBadgeColor}" Padding="5,2" StrokeShape="RoundRectangle 4">
                                                <Label Text="{Binding HealingMethodText}" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding ReconstructionDetailsText}" FontSize="11" TextColor="#F1F5F9" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,10" StrokeShape="RoundRectangle 6"
                                        ToolTipProperties.Text="TreeSHAP local attribution: Shows how each feature pushed the model toward or away from an anomaly classification.">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="LOCAL SHAP FEATURE IMPACT (TOP PREDICTORS)" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Local SHAP values for this observation: Red indicates pushes toward anomaly; Green indicates pushes toward normal.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding LocalShapList}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:ShapLocalFeatureImpact">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="{Binding FriendlyFeatureName}" FontSize="10" FontAttributes="Bold" TextColor="#E2E8F0" />
                                                            <Label Text="{Binding Domain}" FontSize="8" TextColor="#64748B" />
                                                        </VerticalStackLayout>
                                                        <Border Grid.Column="1" BackgroundColor="#1E293B" Padding="6,2" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                                            <Label Text="{Binding Direction}" FontSize="8" FontAttributes="Bold" TextColor="{Binding DirectionColor}" />
                                                        </Border>
                                                        <Label Grid.Column="2" Text="{Binding AbsoluteImpact, StringFormat='{0:F3}'}" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding IsModelsTab}" InputTransparent="{Binding IsNotModelsTab}">
                <VerticalStackLayout Spacing="14">
                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                            ToolTipProperties.Text="Comprehensive model benchmark evaluation, throughput comparisons, and TreeSHAP explainability across candidate algorithms.">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Model Evaluation &amp; Explainability" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="Benchmark comparison and TreeSHAP feature attributions on ISRO AWS data:"
                                       FontSize="11" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                    ToolTipProperties.Text="Overview of anomaly detection algorithms evaluated on 32,774 observations: Isolation Forest, One-Class SVM, Local Outlier Factor, and Calibrated Ensemble.">
                                <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.05*,0.95*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">

                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10"
                                ToolTipProperties.Text="Global feature importance ranked by mean absolute TreeSHAP values across all 32,774 observations.">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Feature Importance (TreeSHAP)" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="Top contributing features in anomaly detection:" FontSize="10" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                            ToolTipProperties.Text="Global SHAP values quantify the average absolute impact of each meteorological feature on anomaly scoring.">
                                        <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <lvc:CartesianChart Series="{Binding ShapChartSeries}"
                                                    XAxes="{Binding ShapXAxes}"
                                                    YAxes="{Binding ShapYAxes}"
                                                    MinimumHeightRequest="270"
                                                    TooltipPosition="Top"
                                                    ToolTipProperties.Text="Horizontal bar chart showing relative SHAP feature importance." />

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="10,8" StrokeShape="RoundRectangle 6"
                                        ToolTipProperties.Text="Key finding derived from TreeSHAP interpretability analysis.">
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="KEY FINDING:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                    ToolTipProperties.Text="Dominant factors driving anomaly identification across the weather station records.">
                                                <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding ShapPrimaryInsight}"
                                               FontSize="10" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="10">
                            <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                    ToolTipProperties.Text="Inference processing speed in observations per second for each evaluated model architecture on CPU.">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Inference Throughput Benchmark (obs/sec)" FontSize="12" FontAttributes="Bold" TextColor="#10B981" />
                                            <Label Text="Candidate model evaluation speed on 32,774 observations:" FontSize="9" TextColor="#94A3B8" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                                ToolTipProperties.Text="Single-core CPU throughput benchmark showing how many 30-minute weather observations each model can evaluate per second.">
                                            <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <lvc:CartesianChart Series="{Binding BenchmarkChartSeries}"
                                                        XAxes="{Binding BenchmarkXAxes}"
                                                        YAxes="{Binding BenchmarkYAxes}"
                                                        MinimumHeightRequest="150"
                                                        TooltipPosition="Top"
                                                        ToolTipProperties.Text="Inference speed comparison: Isolation Forest achieves 11,250 obs/sec." />
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding BenchmarkList}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModelBenchmarkItem">
                                        <Border BackgroundColor="{Binding CardBackground}" Stroke="{Binding CardStroke}" Padding="14,12" StrokeShape="RoundRectangle 10"
                                                ToolTipProperties.Text="Performance benchmarks and operational metrics for this anomaly detection model.">
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding ModelName}" FontSize="13" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
                                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                            ToolTipProperties.Text="Model evaluation summary covering detection accuracy, resource utilization, and throughput.">
                                                        <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Border Grid.Column="2" BackgroundColor="{Binding StatusBadgeBg}" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                        <Label Text="{Binding StatusBadgeLabel}" FontSize="9" FontAttributes="Bold" TextColor="{Binding StatusBadgeText}" />
                                                    </Border>
                                                </Grid>

                                                <Label Text="{Binding Role}" FontSize="10" TextColor="#94A3B8" />

                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,2,0,0">
                                                    <Border BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Scoring speed measured in observations per second on single-core CPU.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="THROUGHPUT" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayThroughput, StringFormat='{0:N0}'}" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="1" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Serialized model artifact size on disk.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="MODEL SIZE" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayDiskSize, StringFormat='{0:F0} KB'}" FontSize="10" FontAttributes="Bold" TextColor="#A855F7" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="2" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Execution time required to fit model on 32,774 training observations.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="TRAIN TIME" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding FitTimeSeconds, StringFormat='{0:F2}s'}" FontSize="10" FontAttributes="Bold" TextColor="#10B981" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="3" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Percentage of total observations flagged as anomalous by this model.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="OUTLIER" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding OutlierRatePct, StringFormat='{0:F1}%'}" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,4,0,0">
                                                    <Border BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Point-adjusted harmonic mean of precision and recall on ground-truth fault injection test set.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="EVENT F1" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayF1Text}" FontSize="10" FontAttributes="Bold" TextColor="#34D399" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="1" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Proportion of flagged anomalies that were true hardware faults.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="PRECISION" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayPrecisionText}" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="2" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="Proportion of actual hardware faults successfully detected.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="RECALL" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayRecallText}" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="3" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6"
                                                            ToolTipProperties.Text="False positive rate: percentage of normal weather readings incorrectly flagged as faults.">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="FPR" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayFprText}" FontSize="10" FontAttributes="Bold" TextColor="#A78BFA" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>

                                                <Label Text="{Binding Strengths}" FontSize="9" TextColor="#CBD5E1" LineBreakMode="WordWrap" Margin="0,2,0,0" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10"
                                    ToolTipProperties.Text="Rigorous ground-truth evaluation table measuring detection rates and detection delays across 7 controlled fault morphologies.">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label Text="Controlled Fault-Injection Benchmark (Ground Truth Test Set)" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                        <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                                ToolTipProperties.Text="Benchmark test set evaluates candidate models on simulated real-world fault types including ADC spikes, flatlines, drift, and weather extremes.">
                                            <Label Text="ⓘ" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                        <Label Text="FAULT MORPHOLOGY" FontSize="8" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Grid.Column="1" Text="IF BASELINE" FontSize="8" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Grid.Column="2" Text="CALIBRATED ENSEMBLE" FontSize="8" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="DETECTION DELAY" FontSize="8" FontAttributes="Bold" TextColor="#64748B" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#1E293B" />
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="ADC Transient Spikes" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="100%" FontSize="9" TextColor="#94A3B8" />
                                        <Label Grid.Column="2" Text="100%" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="Instant (0 steps)" FontSize="9" TextColor="#38BDF8" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="Sensor Flatlines (Frozen)" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="0.0% (Failed)" FontSize="9" TextColor="#EF4444" />
                                        <Label Grid.Column="2" Text="100%" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="3 steps (90 min)" FontSize="9" TextColor="#F59E0B" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="Gradual Calibration Drift" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="42.8%" FontSize="9" TextColor="#F59E0B" />
                                        <Label Grid.Column="2" Text="85.7%" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="5 steps (150 min)" FontSize="9" TextColor="#F59E0B" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="Barometric Transient Steps" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="88.9%" FontSize="9" TextColor="#94A3B8" />
                                        <Label Grid.Column="2" Text="100%" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="Instant (0 steps)" FontSize="9" TextColor="#38BDF8" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="Communication Dropouts" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="100%" FontSize="9" TextColor="#94A3B8" />
                                        <Label Grid.Column="2" Text="100%" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="Instant (0 steps)" FontSize="9" TextColor="#38BDF8" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="Severe Heatwaves (Benign)" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="14.3% False Alarms" FontSize="9" TextColor="#EF4444" />
                                        <Label Grid.Column="2" Text="0.0% False Alarms" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="Filtered Clean" FontSize="9" TextColor="#34D399" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label Text="Thunderstorms (Benign)" FontSize="9" TextColor="#F8FAFC" />
                                        <Label Grid.Column="1" Text="28.6% False Alarms" FontSize="9" TextColor="#EF4444" />
                                        <Label Grid.Column="2" Text="0.0% False Alarms" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                        <Label Grid.Column="3" Text="Filtered Clean" FontSize="9" TextColor="#34D399" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="12" StrokeShape="RoundRectangle 8"
                                    ToolTipProperties.Text="Architecture and rationale for selecting the Calibrated Score Fusion Ensemble as the production model.">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label Text="Selected Production Model: Calibrated Score Fusion Ensemble" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                        <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                                                ToolTipProperties.Text="Blends Isolation Forest (50%), One-Class SVM (30%), and LOF (20%) calibrated via Platt scaling with 13 meteorological physical bounds.">
                                            <Label Text="ⓘ" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                    <Label Text="Combines Isolation Forest (50%), One-Class SVM (30%), and LOF (20%) with physical rules to achieve 71.6% Event F1 (+4.53% over baseline) and 0.0% weather false alarms while retaining exact TreeSHAP interpretability."
                                           FontSize="10" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>

</ContentPage>
