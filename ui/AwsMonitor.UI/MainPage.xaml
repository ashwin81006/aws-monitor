<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:vm="clr-namespace:AwsMonitor.UI.ViewModels"
             xmlns:models="clr-namespace:AwsMonitor.UI.Models"
             x:Class="AwsMonitor.UI.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#0B0F19">

    <Grid RowDefinitions="Auto,Auto,*" Margin="{OnIdiom Phone='10,8', Default='16,12'}" RowSpacing="10">

        <Border Grid.Row="0"
                BackgroundColor="#131B2E"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="{OnIdiom Phone='14,10', Default='18,12'}"
                StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="3">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="AWS Monitor"
                           FontSize="{OnIdiom Phone=17, Default=19}"
                           FontAttributes="Bold"
                           TextColor="#38BDF8"
                           VerticalOptions="Center" />
                    <Border BackgroundColor="#0F3554"
                            Stroke="#0284C7"
                            StrokeThickness="1"
                            Padding="8,2"
                            StrokeShape="RoundRectangle 4"
                            VerticalOptions="Center">
                        <Label Text="Station QC"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="#38BDF8" />
                    </Border>
                </HorizontalStackLayout>
                <Label Text="{Binding LocationText}"
                       FontSize="11"
                       TextColor="#94A3B8"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="#131B2E"
                Stroke="#1E293B"
                StrokeThickness="1"
                Padding="5"
                StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                  ColumnSpacing="6"
                  RowSpacing="6">

                <Button Grid.Row="0" Grid.Column="0"
                        Text="Overview"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Overview"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding OverviewTabBg}"
                        TextColor="White" />

                <Button Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=1}"
                        Text="Incidents &amp; Health"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Incidents"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding IncidentsTabBg}"
                        TextColor="White" />

                <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}"
                        Text="Sensor Simulator"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Tester"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding TesterTabBg}"
                        TextColor="White" />

                <Button Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}"
                        Text="AI Models &amp; SHAP"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Models"
                        FontSize="{OnIdiom Phone=12, Default=11}"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        HeightRequest="{OnIdiom Phone=40, Default=34}"
                        Padding="6,0"
                        BackgroundColor="{Binding ModelsTabBg}"
                        TextColor="White" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">

            <ScrollView IsVisible="{Binding IsOverviewTab}" InputTransparent="{Binding IsNotOverviewTab}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="{OnIdiom Phone='*,*', Default='*,*,*,*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="10"
                          RowSpacing="10">

                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=0}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="TOTAL OBSERVATIONS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding TotalReadingsCount, StringFormat='{0:N0} Records'}" FontSize="20" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="{Binding DateRangeText}" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="SENSOR FAULTS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding ProbableFaultsCount, StringFormat='{0} Faults'}" FontSize="20" FontAttributes="Bold" TextColor="#EF4444" />
                                <Label Text="Hardware glitches detected" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="WEATHER EXTREMES" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding WeatherExtremesCount, StringFormat='{0} Extremes'}" FontSize="20" FontAttributes="Bold" TextColor="#F59E0B" />
                                <Label Text="Natural extremes confirmed" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=1, Default=3}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="STATION HEALTH" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding HealthScore, StringFormat='{0:F1}%'}" FontSize="20" FontAttributes="Bold" TextColor="#10B981" />
                                    <Border BackgroundColor="#064E3B" Padding="4,1" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                        <Label Text="EXCELLENT" FontSize="9" FontAttributes="Bold" TextColor="#34D399" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="Surface channels operational" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Station Quality Control" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                            <Label Text="Automated telemetry monitoring for Automatic Weather Stations. Uses 13 physical meteorological indicators (dew point depression, solar diurnal variations, and rate-of-change limits) to distinguish hardware faults from natural extreme weather."
                                   FontSize="11" TextColor="#CBD5E1" LineBreakMode="WordWrap" />

                            <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                                <Button Text="Incidents &amp; Health"
                                        Command="{Binding SwitchTabCommand}"
                                        CommandParameter="Incidents"
                                        BackgroundColor="#0284C7" TextColor="White"
                                        FontSize="{OnIdiom Phone=13, Default=11}"
                                        HeightRequest="{OnIdiom Phone=42, Default=34}"
                                        CornerRadius="6" Padding="16,0" />

                                <Button Text="Test Diagnostics"
                                        Command="{Binding SwitchTabCommand}"
                                        CommandParameter="Tester"
                                        BackgroundColor="#1E293B" TextColor="#38BDF8" BorderColor="#38BDF8" BorderWidth="1"
                                        FontSize="{OnIdiom Phone=13, Default=11}"
                                        HeightRequest="{OnIdiom Phone=42, Default=34}"
                                        CornerRadius="6" Padding="16,0" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding IsIncidentsTab}" InputTransparent="{Binding IsNotIncidentsTab}">
                <VerticalStackLayout Spacing="14">

                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tower Sensor Health &amp; Physical Calibration" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="Live operational integrity across atmospheric sensing instruments:" FontSize="10" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#064E3B" Stroke="Transparent" Padding="8,3" StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                                <Label Text="{Binding OverallStatusText}" FontSize="10" FontAttributes="Bold" TextColor="#34D399" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,*,*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Default='Auto'}"
                          ColumnSpacing="10" RowSpacing="10"
                          BindableLayout.ItemsSource="{Binding SensorsList}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SensorChannelHealth">
                                <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding DisplayName}" FontSize="12" FontAttributes="Bold" TextColor="#F8FAFC" />
                                            <Border Grid.Column="1" BackgroundColor="#064E3B" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                <Label Text="{Binding Status}" FontSize="9" FontAttributes="Bold" TextColor="{Binding StatusBadgeColor}" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Border BackgroundColor="#0B1220" Stroke="#1E293B" Padding="8,6" StrokeShape="RoundRectangle 6">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="HEALTH SCORE" FontSize="8" TextColor="#64748B" FontAttributes="Bold" />
                                                    <Label Text="{Binding QualityScorePct, StringFormat='{0:F1}%'}" FontSize="13" FontAttributes="Bold" TextColor="#34D399" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Grid.Column="1" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="8,6" StrokeShape="RoundRectangle 6">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="FLAGGED EVENTS" FontSize="8" TextColor="#64748B" FontAttributes="Bold" />
                                                    <Label Text="{Binding FlaggedAnomalyCount, StringFormat='{0:N0}'}" FontSize="13" FontAttributes="Bold" TextColor="#F59E0B" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding QualityDescription}" FontSize="9" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>

                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.05*,0.95*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">

                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Anomalies by Failure Category" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                    <Label Text="Model classification of identified sensor anomalies across 32,774 records:" FontSize="10" TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <lvc:CartesianChart Series="{Binding IncidentChartSeries}"
                                                    XAxes="{Binding IncidentXAxes}"
                                                    YAxes="{Binding IncidentYAxes}"
                                                    MinimumHeightRequest="220"
                                                    TooltipPosition="Top" />

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="10,8" StrokeShape="RoundRectangle 6">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="TOTAL ANALYZED" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                            <Label Text="{Binding ProblemIncidentsCount, StringFormat='{0:N0}'}" FontSize="11" FontAttributes="Bold" TextColor="#F8FAFC" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="HARDWARE FAULTS" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                            <Label Text="{Binding ProbableFaultsCount, StringFormat='{0:N0}'}" FontSize="11" FontAttributes="Bold" TextColor="#EF4444" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                                            <Label Text="BENIGN EXTREMES" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                            <Label Text="{Binding WeatherExtremesCount, StringFormat='{0:N0}'}" FontSize="11" FontAttributes="Bold" TextColor="#10B981" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Flagged Anomaly Incidents Log" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="Detailed root cause isolation for logged station events:" FontSize="10" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                        <Label Text="{Binding EventsList.Count, StringFormat='{0} Events'}" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding EventsList}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:AnomalyEvent">
                                            <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,10" StrokeShape="RoundRectangle 8">
                                                <VerticalStackLayout Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label Text="{Binding RootCause}" FontSize="11" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
                                                        <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                            <Label Text="{Binding PeakScoreText}" FontSize="8" FontAttributes="Bold" TextColor="{Binding SeverityColor}" />
                                                        </Border>
                                                    </Grid>

                                                    <Label Text="{Binding Description}" FontSize="10" TextColor="#94A3B8" LineBreakMode="WordWrap" />

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2,0,0">
                                                        <Label Text="{Binding StartTime}" FontSize="9" TextColor="#64748B" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding EventClassification}" FontSize="9" FontAttributes="Bold" TextColor="{Binding SeverityColor}" HorizontalOptions="End" VerticalOptions="Center" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding IsTesterTab}" InputTransparent="{Binding IsNotTesterTab}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.1*,0.9*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">                        <Border Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=0}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Fault Simulation" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                <Label Text="Select a scenario or enter telemetry values to test diagnostic classification and reconstruction:" FontSize="11" TextColor="#94A3B8" />

                                <Label Text="Preset Scenarios:" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#64748B" />
                                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                    <Button Text="Normal" Command="{Binding LoadPresetNormalCommand}"
                                            BackgroundColor="#1E293B" TextColor="#34D399" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0" />
                                    <Button Text="Spike (-33°C)" Command="{Binding LoadPresetSpikeCommand}"
                                            BackgroundColor="#1E293B" TextColor="#F87171" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0" />
                                    <Button Text="Sensor Freeze" Command="{Binding LoadPresetFreezeCommand}"
                                            BackgroundColor="#1E293B" TextColor="#60A5FA" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0" />
                                    <Button Text="Heatwave (46°C)" Command="{Binding LoadPresetHeatwaveCommand}"
                                            BackgroundColor="#1E293B" TextColor="#FBBF24" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0" />
                                    <Button Text="Low Pressure" Command="{Binding LoadPresetStormCommand}"
                                            BackgroundColor="#1E293B" TextColor="#A78BFA" FontSize="{OnIdiom Phone=12, Default=10}" HeightRequest="{OnIdiom Phone=36, Default=30}" CornerRadius="6" Margin="0,0,6,6" Padding="12,0" />
                                </FlexLayout>

                                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,4" />

                                <Label Text="Telemetry Inputs:" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#64748B" />
                                <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,*,*'}"
                                      RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Default='Auto'}"
                                      ColumnSpacing="10" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Temperature (°C)" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Border BackgroundColor="#0B1324"
                                                Stroke="#334155"
                                                StrokeThickness="1.5"
                                                Padding="12,0"
                                                StrokeShape="RoundRectangle 8"
                                                HeightRequest="{OnIdiom Phone=46, Default=36}">
                                            <Entry Text="{Binding TestTemperature}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#F8FAFC"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom Phone=15, Default=12}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="4">
                                        <Label Text="Relative Humidity (%)" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#34D399" />
                                        <Border BackgroundColor="#0B1324"
                                                Stroke="#334155"
                                                StrokeThickness="1.5"
                                                Padding="12,0"
                                                StrokeShape="RoundRectangle 8"
                                                HeightRequest="{OnIdiom Phone=46, Default=36}">
                                            <Entry Text="{Binding TestHumidity}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#F8FAFC"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom Phone=15, Default=12}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=2, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=2}" Spacing="4">
                                        <Label Text="Pressure (hPa)" FontSize="{OnIdiom Phone=12, Default=10}" FontAttributes="Bold" TextColor="#A78BFA" />
                                        <Border BackgroundColor="#0B1324"
                                                Stroke="#334155"
                                                StrokeThickness="1.5"
                                                Padding="12,0"
                                                StrokeShape="RoundRectangle 8"
                                                HeightRequest="{OnIdiom Phone=46, Default=36}">
                                            <Entry Text="{Binding TestPressure}"
                                                   Keyboard="Numeric"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#F8FAFC"
                                                   FontAttributes="Bold"
                                                   FontSize="{OnIdiom Phone=15, Default=12}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Text="Run Diagnostics"
                                        Command="{Binding RunTestInferenceCommand}"
                                        BackgroundColor="#0284C7"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="{OnIdiom Phone=14, Default=11}"
                                        HeightRequest="{OnIdiom Phone=46, Default=36}"
                                        CornerRadius="8"
                                        Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Diagnostic Results" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,8" StrokeShape="RoundRectangle 6">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="VERDICT" FontSize="9" FontAttributes="Bold" TextColor="#64748B" />
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Border BackgroundColor="{Binding ResultBadgeColor}" Padding="8,3" StrokeShape="RoundRectangle 4">
                                                <Label Text="{Binding ResultStatusBadge}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                            <Label Text="{Binding ResultConfidenceText}" FontSize="11" TextColor="#CBD5E1" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,8" StrokeShape="RoundRectangle 6">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="CLASSIFICATION:" FontSize="9" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding ResultFaultTypeSimple}" FontSize="12" FontAttributes="Bold" TextColor="#F59E0B" />
                                        <Label Text="AFFECTED SENSOR:" FontSize="9" FontAttributes="Bold" TextColor="#64748B" Margin="0,3,0,0" />
                                        <Label Text="{Binding ResultAffectedSensorsText}" FontSize="11" FontAttributes="Bold" TextColor="#F87171" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="12,8" StrokeShape="RoundRectangle 6">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="ANALYSIS:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="{Binding ResultExplanationSimple}" FontSize="11" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="12,8" StrokeShape="RoundRectangle 6">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Text="RECONSTRUCTED VALUE:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding HealingBadgeColor}" Padding="5,2" StrokeShape="RoundRectangle 4">
                                                <Label Text="{Binding HealingMethodText}" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding ReconstructionDetailsText}" FontSize="11" TextColor="#F1F5F9" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding IsModelsTab}" InputTransparent="{Binding IsNotModelsTab}">
                <VerticalStackLayout Spacing="14">
                    <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Model Evaluation &amp; Explainability" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                            <Label Text="Benchmark comparison and TreeSHAP feature attributions on ISRO AWS data:"
                                   FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='1.05*,0.95*'}"
                          RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}"
                          ColumnSpacing="14"
                          RowSpacing="14">

                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#131B2E" Stroke="#1E293B" Padding="16" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Feature Importance (TreeSHAP)" FontSize="13" FontAttributes="Bold" TextColor="#38BDF8" />
                                    <Label Text="Top contributing features in anomaly detection:" FontSize="10" TextColor="#94A3B8" />
                                </VerticalStackLayout>

                                <lvc:CartesianChart Series="{Binding ShapChartSeries}"
                                                    XAxes="{Binding ShapXAxes}"
                                                    YAxes="{Binding ShapYAxes}"
                                                    MinimumHeightRequest="270"
                                                    TooltipPosition="Top" />

                                <Border BackgroundColor="#0F172A" Stroke="#1E293B" Padding="10,8" StrokeShape="RoundRectangle 6">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="KEY FINDING:" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" />
                                        <Label Text="{Binding ShapPrimaryInsight}"
                                               FontSize="10" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="10">
                            <Border BackgroundColor="#131B2E" Stroke="#1E293B" Padding="14,12" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Inference Throughput Benchmark (obs/sec)" FontSize="12" FontAttributes="Bold" TextColor="#10B981" />
                                        <Label Text="Candidate model evaluation speed on 32,774 observations:" FontSize="9" TextColor="#94A3B8" />
                                    </VerticalStackLayout>

                                    <lvc:CartesianChart Series="{Binding BenchmarkChartSeries}"
                                                        XAxes="{Binding BenchmarkXAxes}"
                                                        YAxes="{Binding BenchmarkYAxes}"
                                                        MinimumHeightRequest="150"
                                                        TooltipPosition="Top" />
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding BenchmarkList}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModelBenchmarkItem">
                                        <Border BackgroundColor="{Binding CardBackground}" Stroke="{Binding CardStroke}" Padding="14,12" StrokeShape="RoundRectangle 10">
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                    <Label Text="{Binding ModelName}" FontSize="13" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
                                                    <Border Grid.Column="1" BackgroundColor="{Binding StatusBadgeBg}" Stroke="Transparent" Padding="6,2" StrokeShape="RoundRectangle 4">
                                                        <Label Text="{Binding StatusBadgeLabel}" FontSize="9" FontAttributes="Bold" TextColor="{Binding StatusBadgeText}" />
                                                    </Border>
                                                </Grid>

                                                <Label Text="{Binding Role}" FontSize="10" TextColor="#94A3B8" />

                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,2,0,0">
                                                    <Border BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="THROUGHPUT" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayThroughput, StringFormat='{0:N0}'}" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="1" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="MODEL SIZE" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding DisplayDiskSize, StringFormat='{0:F0} KB'}" FontSize="10" FontAttributes="Bold" TextColor="#A855F7" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="2" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="TRAIN TIME" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding FitTimeSeconds, StringFormat='{0:F2}s'}" FontSize="10" FontAttributes="Bold" TextColor="#10B981" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="3" BackgroundColor="#0B1220" Stroke="#1E293B" Padding="6,4" StrokeShape="RoundRectangle 6">
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="OUTLIER" FontSize="7" TextColor="#64748B" FontAttributes="Bold" />
                                                            <Label Text="{Binding OutlierRatePct, StringFormat='{0:F1}%'}" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>

                                                <Label Text="{Binding Strengths}" FontSize="9" TextColor="#CBD5E1" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Border BackgroundColor="#0C2138" Stroke="#0284C7" Padding="12" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Selected Model: Isolation Forest" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" />
                                    <Label Text="Delivers fastest inference throughput with sub-second training and native TreeSHAP explainability."
                                           FontSize="10" TextColor="#E2E8F0" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>

</ContentPage>
